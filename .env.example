# Copy to .env on the server and fill in. Never commit .env.
# Platform tokens are stored as n8n credentials, not here.

# The hostname you point at the server, for example n8n.example.com
N8N_HOST=

# For example Europe/Amsterdam
TIMEZONE=

# Generate with: openssl rand -hex 32
# Store it in a password manager. Losing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=
